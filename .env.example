# ─────────────────────────────────────────────────────────────────────────────
# Grand Line Tally — environment template
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data source ──────────────────────────────────────────────────────────────
# Leave unset (or 1/true) to run on the bundled demo data — no credentials
# needed, nothing is written anywhere.
# Set to 0/false to read AND write the real Google Sheet.
DEMO_MODE=0

# The spreadsheet id, i.e. the part between /d/ and /edit in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# ── Google credentials (use ONE of the three options) ────────────────────────

# Option 1 (recommended locally / on a venue laptop): a path to the
# service-account .json key. Keeps the private key out of your shell history.
GOOGLE_SERVICE_ACCOUNT_FILE=C:/path/to/service-account.json

# Option 2 (required on Vercel): the whole key file as a single-line value.
# Serverless functions have no disk, so a file path cannot work there.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Option 3: split credentials.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signs the admin login cookie. Must be at least 16 characters, and IS REQUIRED
# in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Escape hatch for local production builds only. Never set this in a real
# deployment.
# ALLOW_INSECURE_SECRET=1

# ── Tuning ───────────────────────────────────────────────────────────────────
# How often the server re-reads the sheet, in milliseconds. Default 60000.
#
# This is the main lever on the Google Sheets read quota. Each poll is a
# `batchGet` across all ten tabs, and Google counts that quota per RANGE, not
# per call — so one poll costs 10 of the 60 reads a service account gets per
# minute, times the number of running instances (they each poll independently).
# At the old 15000 default that was 40/min per instance, so two serverless
# instances exhausted the quota outright and the site stopped refreshing.
#
# Immediate updates do not depend on it: a write refreshes the store itself, so
# this only governs how fast a HAND EDIT made directly in the sheet appears.
# Lower it while hand-editing if you want it snappier.
# SHEET_POLL_MS=60000

# ── First login ──────────────────────────────────────────────────────────────
# Accounts live in the sheet's `Users` tab. The app cannot create its own first
# login, so bootstrap the Super Admin once from the command line — it prints a
# generated password. Everything after that happens in Admin → Accounts.
#
#   npm run create-admin -- superadmin --generate superadmin
#   npm run create-admin -- --list          # or --disable / --remove a username
