# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# spreadsheet backups (local only — they contain the password hashes)
/backups/

# env files (can opt-in for committing if needed)
.env*
# …but the template must ship, otherwise nobody can set the project up.
!.env.example

# Google service-account keys — never commit these
siglakas-*.json
*service-account*.json
*.key.json
.secrets/

# Master brand artwork: multi-megabyte, and the site uses the generated
# copies under /public/brand (see public/brand/README.md).
/*Logo*.png
/dorsu-logo.png
/OSCAL Logo.jpg
/USC.jpg
/OFFICE OF THE STUDENT SPORTS AND WELLNESS.jpg
# Official tally sheets for competitions that have finished. Source documents,
# kept out of the repo; the results they hold are recorded in the sheet by
# scripts/record-saludo-mascot.ts, which cites them by filename.
/OVERALL-*.pdf
/*TABULATION*.pdf
/Saludo criteria.jpg
# Photograph of the official blank Mascot judge sheet — same reason, and it is
# the source that confirms the entry-number -> crew mapping used above.
/856047708_2239775733549482_2597333456696719357_n.jpg

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
